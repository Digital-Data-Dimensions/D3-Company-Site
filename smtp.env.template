# Copy to `.env.local` (gitignored) and set SMTP_PASS. Example for IONOS:
#
# SMTP_HOST=smtp.ionos.com
# SMTP_PORT=587
# SMTP_USER=partner@time-tech.co
# SMTP_PASS=your-mailbox-password
# SALES_EMAIL=partner@time-tech.co
#
# Cloudflare Turnstile (bot protection). Create a widget at dash.cloudflare.com > Turnstile.
# Leave both unset to disable the CAPTCHA (honeypot, timing, rate limit still apply).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
# TURNSTILE_SECRET_KEY=0x4AAAA...
